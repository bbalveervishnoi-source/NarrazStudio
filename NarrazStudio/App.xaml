<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NarrazStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NarrazStudio">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ThemeShadow x:Key="SharedShadow" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Modern Colorful Light Theme Parameters -->
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F0F4F8" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SystemAccentColor" Color="#4F46E5" /> <!-- Vibrant Indigo -->
                    
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
