<Window
    x:Class="NarrazStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NarrazStudio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Narraz">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomBarRow" Height="0"/> 
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Top" Height="32">
            <StackPanel Orientation="Horizontal" Padding="12,0,0,0" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Lang.AppTitle, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Main Application Layout (Sidebar + Editor) -->
            <Grid x:Name="MainAppLayout" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="5" Margin="25,30,25,10">
                    <Button Click="NavigateToHome" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="0">
                        <StackPanel Spacing="5">
                            <Border CornerRadius="12" Background="{ThemeResource ControlFillColorDefaultBrush}" Padding="5" HorizontalAlignment="Center">
                                <Image Source="Assets/AppIcon.png" Width="45" Height="45"/>
                            </Border>
                            <TextBlock Text="{x:Bind Lang.AppTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Lang.AppSubtitle, Mode=OneWay}" FontSize="11" Opacity="0.6" Margin="0,-2,0,5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="25" Margin="0,5,0,15">
                        <Button x:Name="GoToSavedBtn" Click="NavigateToSaved" ToolTipService.ToolTip="{x:Bind Lang.ToolTipSaved, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Opacity="0.8"/>
                        </Button>
                        <Button x:Name="GoToSettingsBtn" Click="NavigateToSettings" ToolTipService.ToolTip="{x:Bind Lang.ToolTipSettings, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE713;" FontSize="20" Opacity="0.8"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="25,0,25,20">
                    <StackPanel Spacing="15">
                        <!-- Voice Settings -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="8" Padding="15" Shadow="{StaticResource SharedShadow}" Translation="0,0,8">
                            <StackPanel Spacing="12">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7FA;" FontSize="14" Opacity="0.8"/>
                                        <TextBlock Text="{x:Bind Lang.NarratorSettings, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="RefreshVoicesBtn" Click="RefreshVoicesBtn_Click" 
                                            Padding="4" Background="Transparent" BorderThickness="0" 
                                            ToolTipService.ToolTip="{x:Bind Lang.VoiceRefresh, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Opacity="0.8"/>
                                    </Button>
                                </Grid>
                                
                                <Button x:Name="VoiceSelectorBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="45" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="SelectedVoiceName" Text="{x:Bind Lang.VoiceConnecting, Mode=OneTime}" FontWeight="Medium" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="320" MaxHeight="550" Spacing="10">
                                                <TextBox x:Name="VoiceSearchBox" PlaceholderText="{x:Bind Lang.VoiceSearch, Mode=OneWay}" TextChanged="VoiceSearchBox_TextChanged" />
                                                <ListView x:Name="VoiceListView" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="VoiceListView_ItemClick" Height="350">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:VoiceModel">
                                                            <StackPanel Padding="5">
                                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{x:Bind Gender}" FontSize="10" Opacity="0.6"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                    <ListView.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate x:DataType="local:VoiceGroup">
                                                                    <TextBlock Text="{x:Bind LanguageName}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" Margin="0,10,0,5" TextWrapping="Wrap"/>
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ListView.GroupStyle>
                                                </ListView>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Audio Adjustments -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="8" Padding="15" Shadow="{StaticResource SharedShadow}" Translation="0,0,8">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                                    <FontIcon Glyph="&#xE9EF;" FontSize="14" Opacity="0.8"/>
                                    <TextBlock Text="{x:Bind Lang.AudioAdjustments, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Lang.Rate, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                                    <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0" Click="ResetRate_Click" ToolTipService.ToolTip="{x:Bind Lang.ResetRate, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                                    </Button>
                                </Grid>
                                <Slider Minimum="-50" Maximum="50" Value="0" x:Name="RateSlider" Margin="0,-10,0,5"/>

                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Lang.Pitch, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Opacity="0.8"/>
                                    <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0" Click="ResetPitch_Click" ToolTipService.ToolTip="{x:Bind Lang.ResetPitch, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                                    </Button>
                                </Grid>
                                <Slider Minimum="-20" Maximum="20" Value="0" x:Name="PitchSlider" Margin="0,-10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="12" Padding="25,0,25,25">
                    <Button x:Name="GoToBatchBtn" Click="NavigateToBatch" HorizontalAlignment="Stretch" Height="45" Background="Transparent" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Lang.BatchExportTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayButton" Click="PlayButton_Click" HorizontalAlignment="Stretch" Height="45" Style="{ThemeResource AccentButtonStyle}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Lang.PlayAudio, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Click="ExportButton_Click" HorizontalAlignment="Stretch" Height="45" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE78C;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Lang.ExportMP3, Mode=OneWay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusLabel" Text="{x:Bind Lang.SystemReady, Mode=OneWay}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid> 

            <Grid Grid.Column="1" Padding="25" x:Name="HomeView">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderThickness="0" 
                        CornerRadius="12"
                        Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                    <Grid>
                        <Grid x:Name="TextContainer" Margin="10">
                            <WebView2 x:Name="EditorWebView" 
                                      HorizontalAlignment="Stretch" 
                                      VerticalAlignment="Stretch"
                                      Margin="5,5,15,5" 
                                      WebMessageReceived="EditorWebView_WebMessageReceived" />
                        </Grid>
                        
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15" 
                                Background="{ThemeResource ControlFillColorDefaultBrush}" 
                                CornerRadius="6" Padding="12,6"
                                Shadow="{StaticResource SharedShadow}" Translation="0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="WordCharCountTextBlock" Text="0 Words • 0 Characters" FontSize="12" FontWeight="Medium" Opacity="0.8" VerticalAlignment="Center"/>
                                <Button x:Name="ClearTextButton" Padding="4" Background="Transparent" BorderThickness="0" Click="ClearTextButton_Click" ToolTipService.ToolTip="{x:Bind Lang.ToolTipClear, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF4B4B"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid> <!-- End MainAppLayout -->

        <!-- Full Screen History / Saved View -->
        <Grid x:Name="HistoryView" Visibility="Collapsed" Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,30">
                <Button Click="NavigateToHome" ToolTipService.ToolTip="{x:Bind Lang.BackToHome, Mode=OneWay}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="24"/>
                </Button>
                <TextBlock Text="{x:Bind Lang.SavedNarrations, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="HistorySearchBox" PlaceholderText="{x:Bind Lang.SearchByFilename, Mode=OneWay}" QueryIcon="Find" Width="350" HorizontalAlignment="Left" TextChanged="HistorySearchBox_TextChanged"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Lang.Period, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        <ComboBox x:Name="FilterDateSelector" Width="140" SelectedIndex="0" SelectionChanged="FilterDateSelector_SelectionChanged">
                            <ComboBoxItem Content="{x:Bind Lang.AllRecords, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.Today, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.Yesterday, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.LastWeek, Mode=OneWay}"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Lang.SortBy, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                        <ComboBox x:Name="SortSelector" SelectionChanged="SortSelector_SelectionChanged" Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="{x:Bind Lang.SortNewest, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.SortOldest, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.SortAZ, Mode=OneWay}"/>
                            <ComboBoxItem Content="{x:Bind Lang.SortChar, Mode=OneWay}"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Table Header -->
            <Grid Grid.Row="2" Margin="15,0,15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Lang.HeaderSrNo, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Lang.HeaderTitle, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Lang.HeaderNarrator, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6"/>
                <TextBlock Grid.Column="3" Text="{x:Bind Lang.HeaderInfo, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6"/>
                <TextBlock Grid.Column="4" Text="{x:Bind Lang.HeaderActions, Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right"/>
            </Grid>

            <ListView Grid.Row="3" x:Name="HistoryListView" ItemsSource="{x:Bind _historyList}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="8" Margin="0,0,0,10" Padding="15" Shadow="{StaticResource SharedShadow}" Translation="0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sr No -->
                                <TextBlock Grid.Column="0" Text="{x:Bind SrNo}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Opacity="0.5"/>

                                <!-- Title and Date -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind DateString}" FontSize="12" Opacity="0.6"/>
                                </StackPanel>

                                <!-- Narrator -->
                                <TextBlock Grid.Column="2" Text="{x:Bind VoiceName}" VerticalAlignment="Center" FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>

                                <!-- General Info -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Opacity="0.7">
                                    <TextBlock FontSize="12"><Run Text="{x:Bind CharCount}"/> <Run Text="{x:Bind Lang.Chars, Mode=OneWay}"/></TextBlock>
                                    <TextBlock FontSize="12"><Run Text="{x:Bind WordCount}"/> <Run Text="{x:Bind Lang.Words, Mode=OneWay}"/></TextBlock>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button ToolTipService.ToolTip="{x:Bind Lang.ToolTipOpen, Mode=OneWay}" Click="OpenHistoryFile_Click" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="{x:Bind Lang.ToolTipFolder, Mode=OneWay}" Click="OpenHistoryFolder_Click" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xED25;" FontSize="16"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="{x:Bind Lang.ToolTipDelete, Mode=OneWay}" Click="DeleteHistoryItem_Click" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#FF4B4B"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Full Screen Settings View -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="40,30,40,30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,0,15,60">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <Button Click="NavigateToHome" ToolTipService.ToolTip="{x:Bind Lang.BackToHome, Mode=OneWay}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="24"/>
                        </Button>
                        <TextBlock Text="{x:Bind Lang.SettingsTitle, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>


                    <!-- Theme Engine -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock Text="{x:Bind Lang.ThemeEngine, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Lang.Appearance, Mode=OneWay}" Opacity="0.5" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ThemeSelector" MinWidth="200" SelectedIndex="2" SelectionChanged="ThemeSelector_Changed">
                                <ComboBoxItem Content="{x:Bind Lang.Light, Mode=OneWay}" Tag="Light"/>
                                <ComboBoxItem Content="{x:Bind Lang.Dark, Mode=OneWay}" Tag="Dark"/>
                                <ComboBoxItem Content="{x:Bind Lang.SystemDefault, Mode=OneWay}" Tag="System"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Mica Backdrop -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{x:Bind Lang.MicaToggle, Mode=OneWay}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.4" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Lang.MicaTooltip, Mode=OneWay}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="MicaSwitch" HorizontalAlignment="Right" IsOn="True" MinWidth="0" Toggled="MicaSwitch_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Language Selector -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8C1;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{x:Bind Lang.LanguageLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LanguageSelector" MinWidth="200" SelectedIndex="0" SelectionChanged="LanguageSelector_Changed">
                                <ComboBoxItem Content="{x:Bind Lang.SystemDefault, Mode=OneWay}" Tag="System"/>
                                <ComboBoxItem Content="{x:Bind Lang.English, Mode=OneWay}" Tag="en"/>
                                <ComboBoxItem Content="{x:Bind Lang.Hindi, Mode=OneWay}" Tag="hi"/>
                                <ComboBoxItem Content="{x:Bind Lang.Chinese, Mode=OneWay}" Tag="zh"/>
                                <ComboBoxItem Content="{x:Bind Lang.Urdu, Mode=OneWay}" Tag="ur"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Parallel Chunk Limit -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8D5;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <TextBlock Text="{x:Bind Lang.ParallelChunkLimit, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                                    <Button Click="ResetParallelLimit_Click" Padding="4" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Lang.ResetParallelLimit, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Opacity="0.6"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Lang.ParallelChunkDesc, Mode=OneWay}" Opacity="0.5" FontSize="12" Margin="26,0,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ParallelLimitSelector" MinWidth="200" SelectedIndex="14" SelectionChanged="ParallelLimitSelector_Changed"/>
                        </Grid>
                    </Border>

                    <!-- System Diagnostics -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{x:Bind Lang.SystemDiagnostics, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="30,0,0,0" VerticalAlignment="Center">
                                <FontIcon x:Name="FFmpegStatusIcon" Glyph="&#xE73E;" FontSize="20" Foreground="LightGreen" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FFmpegStatusText" Text="FFmpeg Linked" TextWrapping="NoWrap" FontSize="13" VerticalAlignment="Center" Opacity="0.8"/>
                            </StackPanel>
                            <Button Grid.Column="2" Click="CheckFFmpegBtn_Click" Padding="6" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Developer Info -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{x:Bind Lang.AboutDev, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="{x:Bind Lang.DevName, Mode=OneWay}" FontSize="15" Opacity="0.9" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="{x:Bind Lang.DevVersion, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Legal & Licenses -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0" CornerRadius="12" Padding="24,20" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xEA1F;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{x:Bind Lang.LegalTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Lang.LegalApp, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Lang.LegalFFmpeg, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Lang.LegalEdgeTts, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Lang.LegalWebView, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,10" Margin="0,4,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Lang.LegalDisclaimer, Mode=OneWay}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Lang.LegalPrivacy, Mode=OneWay}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Full Screen Batch View -->
        <Grid x:Name="BatchView" Visibility="Collapsed" Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,30">
                <Button Click="NavigateToHome" ToolTipService.ToolTip="{x:Bind Lang.BackToHome, Mode=OneWay}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="24"/>
                </Button>
                <TextBlock Text="{x:Bind Lang.BatchExportTitle, Mode=OneWay}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Click="BatchOpenFiles_Click" Style="{ThemeResource AccentButtonStyle}" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                        <TextBlock Text="{x:Bind Lang.OpenFiles, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
                <Button Click="BatchClearAll_Click" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF4B4B"/>
                        <TextBlock Text="{x:Bind Lang.ClearAll, Mode=OneWay}" Foreground="#FF4B4B"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView Grid.Row="1" x:Name="BatchFilesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BatchExportItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Shadow="{StaticResource SharedShadow}" Translation="0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5" Margin="0,0,20,0">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind FileSizeStr}" FontSize="12" Opacity="0.6"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4CAF50" Visibility="{x:Bind CheckmarkVisibility, Mode=OneWay}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Margin="0,5,0,0" Foreground="{ThemeResource SystemAccentColor}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <!-- Convert Button -->
                                    <Button Click="BatchConvertSingle_Click" Style="{ThemeResource AccentButtonStyle}" Visibility="{x:Bind ConvertBtnVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE78C;" FontSize="12"/>
                                            <TextBlock Text="{x:Bind Lang.Convert, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Cancel Button -->
                                    <Button Click="BatchCancelSingle_Click" Background="#22FF4B4B" BorderThickness="0" Visibility="{x:Bind CancelBtnVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#FF4B4B"/>
                                            <TextBlock Text="Cancel" Foreground="#FF4B4B"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Locate Button -->
                                    <Button Click="BatchLocateSingle_Click" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Visibility="{x:Bind LocateBtnVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="12"/>
                                            <TextBlock Text="{x:Bind Lang.Locate, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BatchDeleteItem_Click" Background="Transparent" BorderThickness="0" IsEnabled="{x:Bind IsDeleteEnabled, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#FF4B4B"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,15,0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20" Margin="0,20,0,0" BorderThickness="0" Shadow="{StaticResource SharedShadow}" Translation="0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="BatchSelectSavePath_Click" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Lang.SelectSavePath, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="BatchSavePathText" Text="..." Margin="15,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BatchCancelAllBtn" Click="BatchCancelAll_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#FF4B4B"/>
                                <TextBlock Text="{x:Bind Lang.CancelAll, Mode=OneWay}" Foreground="#FF4B4B"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BatchLocateAllBtn" Click="BatchLocateAll_Click" Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                <TextBlock Text="{x:Bind Lang.LocateAll, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BatchExportAllBtn" Click="BatchExportAll_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE78C;" FontSize="14"/>
                                <TextBlock Text="{x:Bind Lang.ExportAll, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Grid Grid.Row="2" x:Name="PlaybackBar" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="40,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <Button x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="20" Background="Transparent" Click="PlayPauseButton_Click"/>
                <Button x:Name="StopButton" Content="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="18" Background="Transparent" Click="StopButton_Click"/>
                <TextBlock x:Name="CurrentVoiceLabel" Text="Selected Voice" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <Slider Grid.Column="1" VerticalAlignment="Center" Margin="50,0" x:Name="PlaybackSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="PlaybackSlider_ValueChanged"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock x:Name="TimeLabel" Text="00:00 / 00:00" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                <SymbolIcon Symbol="Volume" /> 
                <Button x:Name="ClosePlaybackButton" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="16" Background="Transparent" Click="ClosePlaybackButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ProgressOverlay" Visibility="Collapsed" Background="#CC000000" Grid.RowSpan="3">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    CornerRadius="12" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Width="450" BorderThickness="1" BorderBrush="#33FFFFFF">
                
                <StackPanel Spacing="20">
                    <StackPanel x:Name="ExportProgressState" Spacing="20">
                        <ProgressRing IsActive="True" Width="50" Height="50" Foreground="Cyan"/>
                        <TextBlock Text="{x:Bind Lang.ExportingAudio, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusDetailLabel" Text="{x:Bind Lang.ProcessingChunks, Mode=OneWay}" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock x:Name="StatusChunkLabel" Text="" HorizontalAlignment="Center" FontSize="11" Opacity="0.5"/>
                        <Button x:Name="CancelExportButton" HorizontalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource DefaultButtonStyle}" Click="CancelExportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#FF4B4B"/>
                                <TextBlock Text="{x:Bind Lang.CancelExport, Mode=OneWay}" Foreground="#FF4B4B"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="ExportSuccessState" Visibility="Collapsed" Spacing="15">
                        <FontIcon Glyph="&#xE73E;" FontSize="50" Foreground="LightGreen" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind Lang.ExportSuccessful, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Opacity="0.8">
                            <TextBlock x:Name="SuccessFileName" Text="Filename.mp3" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SuccessFilePath" Text="C:/Users/..." FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="{x:Bind Lang.OpenFolder, Mode=OneWay}" Click="OpenFolder_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="{x:Bind Lang.Done, Mode=OneWay}" Click="CloseOverlay_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ExportFailureState" Visibility="Collapsed" Spacing="15">
                        <FontIcon Glyph="&#xEA39;" FontSize="50" Foreground="#FF4B4B" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailureTitle" Text="{x:Bind Lang.ExportFailed, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FailureReason" Text="{x:Bind Lang.SomethingWentWrong, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" HorizontalAlignment="Center" MaxWidth="350"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="FailureOkBtn" Content="{x:Bind Lang.OK, Mode=OneWay}" Click="CloseOverlay_Click" Width="80"/>
                            <Button x:Name="FailurePrimaryBtn" Content="{x:Bind Lang.TryAgain, Mode=OneWay}" Click="FailurePrimaryBtn_Click" Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="FailureSecondaryBtn" Content="{x:Bind Lang.Cancel, Mode=OneWay}" Click="CloseOverlay_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
